{
  "manifest_version": 3,
  "name": "TICKK Outbound Audit",
  "version": "2.0",
  "description": "Sender-side outbound email audit & delivery confirmation logger for Gmail — with real-time tracking dashboard.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://tick-email-tracker.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TICKK — Outbound Audit Dashboard"
  }
}